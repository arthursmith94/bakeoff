# Copy to .env.local to override. All values are optional.
# HTTP RPC endpoint (default: Cookie Chain mainnet).
VITE_RPC_URL=https://rpc.cookiescan.io
# WebSocket endpoint (default: wss://wss.cookiescan.io; derived from RPC URL if empty on localnet).
VITE_WS_URL=wss://wss.cookiescan.io
# Genesis hash of the chain the wallet should be on (used for the Nightly "Switch network" prompt).
VITE_GENESIS_HASH=9wDaBRDgArEUpvhHxGguNkwozsZh4UpGZB9o2EoEcBB2

# Local dev against `solana-test-validator`:
# VITE_RPC_URL=http://127.0.0.1:8899
# VITE_WS_URL=ws://127.0.0.1:8900
